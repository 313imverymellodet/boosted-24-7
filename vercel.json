{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "boosted-24-7\\.vercel\\.app"
        }
      ],
      "destination": "https://www.boostdetroit247.com/:path*",
      "permanent": true
    }
  ]
}
